<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="32dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_item"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:textColor="#152D26"
        android:textSize="13sp" />
    <Button android:id="@+id/widget_done"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp"
        android:paddingStart="5dp" android:paddingEnd="5dp"
        android:background="?android:attr/selectableItemBackground"
        android:textColor="#0B6250" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
