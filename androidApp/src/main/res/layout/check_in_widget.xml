<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/widget_root"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_background"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <LinearLayout
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="28dp">
            <TextView android:id="@+id/widget_progress"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center_vertical"
                android:maxLines="1" android:ellipsize="end"
                android:text="@string/widget_name" android:textColor="#0B6250"
                android:textSize="13sp" android:textStyle="bold"/>
            <LinearLayout android:id="@+id/widget_pager"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:visibility="gone">
                <Button android:id="@+id/widget_previous"
                    android:layout_width="32dp" android:layout_height="match_parent"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/widget_previous_page"
                    android:text="@string/widget_previous_symbol" android:textColor="#0B6250" android:textSize="18sp"/>
                <TextView android:id="@+id/widget_page"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#32574B" android:textSize="12sp"/>
                <Button android:id="@+id/widget_next"
                    android:layout_width="32dp" android:layout_height="match_parent"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/widget_next_page"
                    android:text="@string/widget_next_symbol" android:textColor="#0B6250" android:textSize="18sp"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginBottom="2dp" android:progressTint="#0B6250"
            android:progressBackgroundTint="#AEDCCE"/>
        <LinearLayout android:id="@+id/widget_items"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
        <TextView android:id="@+id/widget_empty"
            android:layout_width="match_parent" android:layout_height="32dp"
            android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"
            android:text="@string/widget_empty" android:textColor="#32574B" android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
